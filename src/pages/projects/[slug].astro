---
import { ArrowLeft, ArrowRight } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import projects from '../../data/projects.json';
import { withBase } from '../../utils/content';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
const currentIndex = projects.findIndex((item) => item.slug === project.slug);
const nextProject = projects[(currentIndex + 1) % projects.length];
---
<BaseLayout title={project.title} description={project.summary} image={project.image} structuredData={{'@context': 'https://schema.org', '@type': 'CreativeWork', name: project.title, description: project.summary, author: {'@type': 'Person', name: 'Haytham Hussein'}}}>
  <article>
    <header class="article-header">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href={withBase()}>Home</a></li><li><a href={withBase('projects/')}>Projects</a></li><li aria-current="page">{project.title}</li></ol></nav>
        <p class="eyebrow">{project.category}{project.year ? ` · ${project.year}` : ''}</p>
        <h1>{project.title}</h1>
        <p>{project.summary}</p>
        {project.sample && <span class="sample-badge">Sample project</span>}
      </div>
    </header>
    <div class="container section-compact reveal"><img src={withBase(project.image)} alt="" width="1200" height="750" /></div>
    <div class="narrow article-body">
      <section class="flow reveal"><p class="eyebrow">Overview</p><h2>The question and its context.</h2><p>{project.overview}</p></section>
      <section class="flow reveal"><p class="eyebrow">Approach</p><h2>Methods, decisions, and collaboration.</h2><p>{project.approach}</p></section>
      <section class="flow reveal"><p class="eyebrow">Outcome</p><h2>Outputs and evidence of value.</h2><p>{project.outcome}</p></section>
      <div class="flow reveal"><h3>Methods and technologies</h3><ul class="tag-list">{project.technologies.map((item) => <li class="tag">{item}</li>)}</ul></div>
      {project.links && <div class="flow reveal"><h3>Related publications</h3>{project.links.map((link: { label: string; url: string }) => <p><a class="text-link" href={link.url}>{link.label}</a></p>)}</div>}
      <div class="article-footer button-row reveal"><a class="button button-secondary" href={withBase('projects/')}><ArrowLeft size={17} aria-hidden="true" /> All projects</a><a class="text-link" href={withBase(`projects/${nextProject.slug}/`)}>Next: {nextProject.title} <ArrowRight size={17} aria-hidden="true" /></a></div>
    </div>
  </article>
</BaseLayout>
