---
import { ArrowLeft, ArrowRight } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import news from '../../data/news.json';
import { formatDate, withBase } from '../../utils/content';

export function getStaticPaths() {
  return news.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const currentIndex = news.findIndex((item) => item.slug === post.slug);
const nextPost = news[(currentIndex + 1) % news.length];
---
<BaseLayout title={post.title} description={post.excerpt} type="article" image="/images/news-feature.svg" structuredData={{'@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.title, description: post.excerpt, datePublished: post.date, author: {'@type': 'Person', name: 'Haytham Hussein'}}}>
  <article>
    <header class="article-header">
      <div class="narrow reveal">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href={withBase()}>Home</a></li><li><a href={withBase('news/')}>News &amp; notes</a></li><li aria-current="page">{post.title}</li></ol></nav>
        <p class="eyebrow">{post.category} · <time datetime={post.date}>{post.displayDate || formatDate(post.date)}</time></p>
        <h1>{post.title}</h1><p>{post.excerpt}</p>
        <ul class="tag-list">{post.tags.map((tag) => <li class="tag">{tag}</li>)}</ul>
        {post.sample && <span class="sample-badge">Sample article</span>}
      </div>
    </header>
    <div class="narrow article-body">
      {post.body.map((paragraph) => <p class="reveal">{paragraph}</p>)}
      <div class="article-footer button-row reveal"><a class="button button-secondary" href={withBase('news/')}><ArrowLeft size={17} aria-hidden="true" /> All notes</a><a class="text-link" href={withBase(`news/${nextPost.slug}/`)}>Next: {nextPost.title} <ArrowRight size={17} aria-hidden="true" /></a></div>
    </div>
  </article>
</BaseLayout>
