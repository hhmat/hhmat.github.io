---
import { ArrowRight, GraduationCap, Trophy } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import profile from '../data/profile.json';
import experience from '../data/experience.json';
import expertise from '../data/expertise.json';
import education from '../data/education.json';
import awards from '../data/awards.json';
import { withBase } from '../utils/content';

type EducationItem = { qualification: string; institution: string; period: string; details: string };
type AwardItem = { title: string; organisation: string; year: string; details: string };
const educationItems = education as EducationItem[];
const awardItems = awards as AwardItem[];
---
<BaseLayout title="About" description="Biography, professional experience, expertise, education, grants, and awards for Haytham Hussein, AXA Research Fellow at the University of Nottingham." type="profile">
  <PageHero eyebrow="About" title="Electrochemistry across academia and industry." intro="Research and professional experience spanning advanced materials, energy storage, electrodeposition, microscopy, and scientific engagement." breadcrumb="About" />

  <section class="section" aria-labelledby="biography-title">
    <div class="container page-hero-grid">
      <div class="reveal"><p class="eyebrow">Biography</p><h2 id="biography-title">Haytham Hussein</h2><p class="muted">{profile.role} · {profile.location}</p></div>
      <div class="flow reveal">{profile.bio.map((paragraph) => <p>{paragraph}</p>)}<a class="text-link" href={withBase('contact/')}>Professional enquiries <ArrowRight size={17} aria-hidden="true" /></a></div>
    </div>
  </section>

  <section class="section section-subtle" aria-labelledby="experience-title">
    <div class="container">
      <div class="section-heading reveal"><div><p class="eyebrow">Experience</p><h2 id="experience-title">Professional journey.</h2></div><p>Research and industrial roles across the United Kingdom and Saudi Arabia.</p></div>
      <ol class="timeline">
        {experience.map((item) => (
          <li class="timeline-item reveal">
            <div class="timeline-period">{item.period}{item.sample && <span class="sample-badge">Template</span>}</div>
            <div><h3>{item.role}</h3><p><strong>{item.organisation}</strong> · {item.location}</p><p>{item.summary}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="expertise-title">
    <div class="container">
      <div class="section-heading reveal"><div><p class="eyebrow">Expertise</p><h2 id="expertise-title">Capabilities by category.</h2></div><p>Experimental, analytical, computational, and communication skills developed through research, teaching, and industrial practice.</p></div>
      <div class="expertise-grid">
        {expertise.map((group) => <section class="expertise-group reveal"><h3>{group.category}</h3><ul>{group.skills.map((skill) => <li>{skill}</li>)}</ul></section>)}
      </div>
    </div>
  </section>

  <section class="section section-subtle" aria-labelledby="education-title">
    <div class="container page-hero-grid">
      <div class="reveal"><GraduationCap size={28} stroke-width={1.5} aria-hidden="true" /><p class="eyebrow">Education</p><h2 id="education-title">Academic qualifications.</h2></div>
      <div class="reveal">
        {educationItems.length === 0 ? <div class="empty-state"><h3>Add your education history</h3><p>No qualifications have been supplied. Add degree, institution, subject, dates, and relevant distinctions in <code>src/data/education.json</code>.</p></div> : <div class="timeline">{educationItems.map((item) => <article class="timeline-item"><div class="timeline-period">{item.period}</div><div><h3>{item.qualification}</h3><p><strong>{item.institution}</strong></p><p>{item.details}</p></div></article>)}</div>}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="awards-title">
    <div class="container page-hero-grid">
      <div class="reveal"><Trophy size={28} stroke-width={1.5} aria-hidden="true" /><p class="eyebrow">Awards</p><h2 id="awards-title">Recognition and honours.</h2></div>
      <div class="reveal">
        {awardItems.length === 0 ? <div class="empty-state"><h3>Add professional recognition</h3><p>No awards have been supplied. Add verified awards, fellowships, grants, and honours in <code>src/data/awards.json</code>.</p></div> : <div class="timeline">{awardItems.map((item) => <article class="timeline-item"><div class="timeline-period">{item.year}</div><div><h3>{item.title}</h3><p><strong>{item.organisation}</strong></p><p>{item.details}</p></div></article>)}</div>}
      </div>
    </div>
  </section>
</BaseLayout>
