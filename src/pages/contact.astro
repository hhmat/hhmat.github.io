---
import { ArrowUpRight, Mail, MapPin, Send } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import profile from '../data/profile.json';

const links = [
  { label: 'LinkedIn', url: profile.links.linkedin },
  { label: 'GitHub', url: profile.links.github },
  { label: 'Google Scholar', url: profile.links.scholar },
  { label: 'ORCID', url: profile.links.orcid },
  { label: 'ResearchGate', url: profile.links.researchgate },
].filter((link) => link.url);
---
<BaseLayout title="Contact" description="Contact Haytham Hussein, AXA Research Fellow at the University of Nottingham, about electrochemistry, materials research, and scientific collaboration.">
  <PageHero eyebrow="Contact" title="Start a thoughtful conversation." intro="For research collaborations, academic enquiries, or scientific exchange, use the contact form or connect through a professional profile." breadcrumb="Contact" />
  <section class="section">
    <div class="container contact-grid">
      <div class="contact-details reveal">
        <div class="contact-item"><h2><MapPin size={17} aria-hidden="true" style="display:inline" /> Location</h2><p>{profile.location}</p></div>
        <div class="contact-item"><h2><Mail size={17} aria-hidden="true" style="display:inline" /> Enquiries</h2><p>Use the contact form to send a private message. Your email address will only be used to reply to your enquiry.</p></div>
        {links.map((link) => <div class="contact-item"><h2>{link.label}</h2><p><a class="text-link" href={link.url} target="_blank" rel="noopener noreferrer">Visit {link.label} <ArrowUpRight size={16} aria-hidden="true" /></a></p></div>)}
      </div>
      <div class="reveal">
        <p class="eyebrow">Contact form</p>
        <h2>Send your enquiry.</h2>
        <p class="muted">Your name, email address, subject, and message are transmitted through FormSubmit for email delivery. Please do not include sensitive information.</p>
        <form class="contact-form" id="contact-form" action="https://formsubmit.co/hemaihussein@gmail.com" method="POST" novalidate>
          <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
          <input type="hidden" name="_template" value="table" />
          <div class="field"><label for="contact-name">Name</label><input id="contact-name" name="name" type="text" autocomplete="name" required minlength="2" aria-describedby="name-error" /><p class="field-error" id="name-error"></p></div>
          <div class="field"><label for="contact-email-input">Email</label><input id="contact-email-input" name="email" type="email" autocomplete="email" required aria-describedby="email-error" /><p class="field-error" id="email-error"></p></div>
          <div class="field"><label for="contact-subject">Subject</label><input id="contact-subject" name="subject" type="text" required minlength="3" aria-describedby="subject-error" /><p class="field-error" id="subject-error"></p></div>
          <div class="field"><label for="contact-message">Message</label><textarea id="contact-message" name="message" required minlength="20" aria-describedby="message-error"></textarea><p class="field-error" id="message-error"></p></div>
          <div><button class="button" id="contact-submit" type="submit"><span id="submit-label">Send message</span> <Send size={17} aria-hidden="true" /></button></div>
          <div class="form-status" id="form-status" role="status" aria-live="polite" tabindex="-1" hidden>
            <p id="form-status-text"></p>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLDivElement>('#form-status');
  const statusText = document.querySelector<HTMLParagraphElement>('#form-status-text');
  const submitButton = document.querySelector<HTMLButtonElement>('#contact-submit');
  const submitLabel = document.querySelector<HTMLSpanElement>('#submit-label');

  const fields = [
    { id: 'contact-name', error: 'name-error', message: 'Enter your name using at least 2 characters.' },
    { id: 'contact-email-input', error: 'email-error', message: 'Enter a valid email address.' },
    { id: 'contact-subject', error: 'subject-error', message: 'Enter a subject using at least 3 characters.' },
    { id: 'contact-message', error: 'message-error', message: 'Write a message of at least 20 characters.' },
  ];

  const validateField = ({ id, error, message }: typeof fields[number]) => {
    const input = document.querySelector<HTMLInputElement | HTMLTextAreaElement>(`#${id}`);
    const errorElement = document.querySelector<HTMLParagraphElement>(`#${error}`);
    if (!input || !errorElement) return true;
    const valid = input.validity.valid && input.value.trim().length >= (input.getAttribute('minlength') ? Number(input.getAttribute('minlength')) : 1);
    errorElement.textContent = valid ? '' : message;
    input.setAttribute('aria-invalid', String(!valid));
    return valid;
  };

  const showStatus = (message: string, state: 'success' | 'error') => {
    if (!status || !statusText) return;
    status.dataset.state = state;
    statusText.textContent = message;
    status.hidden = false;
    status.focus();
  };

  fields.forEach((field) => document.querySelector(`#${field.id}`)?.addEventListener('input', () => validateField(field)));
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const validity = fields.map(validateField);
    if (validity.includes(false)) {
      const firstInvalid = form.querySelector<HTMLElement>('[aria-invalid="true"]');
      firstInvalid?.focus();
      return;
    }

    if (submitButton) submitButton.disabled = true;
    if (submitLabel) submitLabel.textContent = 'Sending…';
    if (status) status.hidden = true;

    try {
      const data = new FormData(form);
      data.set('_subject', `Website enquiry: ${String(data.get('subject'))}`);
      const endpoint = new URL(form.action);
      endpoint.pathname = `/ajax${endpoint.pathname}`;
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: data,
      });
      const result = await response.json().catch(() => null) as { success?: boolean | string } | null;
      if (!response.ok || !result || result.success === false || result.success === 'false') throw new Error('Submission failed');

      form.reset();
      fields.forEach((field) => {
        const input = document.querySelector<HTMLInputElement | HTMLTextAreaElement>(`#${field.id}`);
        const errorElement = document.querySelector<HTMLParagraphElement>(`#${field.error}`);
        input?.removeAttribute('aria-invalid');
        if (errorElement) errorElement.textContent = '';
      });
      showStatus('Thank you—your enquiry has been submitted successfully. Haytham will reply to the email address you provided.', 'success');
    } catch {
      showStatus('Sorry, your message could not be sent. Please check your connection and try again.', 'error');
    } finally {
      if (submitButton) submitButton.disabled = false;
      if (submitLabel) submitLabel.textContent = 'Send message';
    }
  });
</script>
