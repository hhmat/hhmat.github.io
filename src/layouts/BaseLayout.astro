---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import profile from '../data/profile.json';
import { withBase } from '../utils/content';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  structuredData?: Record<string, unknown>;
}
const { title, description, image = '/images/og-image.png', type = 'website', noindex = false, structuredData } = Astro.props;
const pageTitle = title === profile.name ? title : `${title} | ${profile.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
const socialImage = new URL(withBase(image), Astro.site || Astro.url.origin);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  address: { '@type': 'PostalAddress', addressLocality: 'Nottingham', addressCountry: 'GB' },
  url: new URL(withBase(), Astro.site || Astro.url.origin).toString(),
  sameAs: Object.values(profile.links).filter(Boolean),
};
---
<!doctype html>
<html lang="en" data-base={import.meta.env.BASE_URL}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#172a43" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('icons/favicon.svg')} />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Haytham Hussein — electrochemistry, materials, and sustainable technologies" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData || person)} />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('haytham-theme');
          document.documentElement.dataset.theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
    <SearchDialog />
    <script>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('motion-ready');
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -5% 0px', threshold: 0.05 });
        document.querySelectorAll('.reveal').forEach((element) => observer.observe(element));
      }
    </script>
  </body>
</html>
